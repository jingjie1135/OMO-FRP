{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Remote Platform",
  "version": "0.1.0",
  "identifier": "dev.opencode.remote-platform",
  "build": {
    "beforeDevCommand": "bun run --cwd .. dev:ui",
    "beforeBuildCommand": "bun run --cwd .. build:ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenCode Remote Platform",
        "width": 1200,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
