{
  "name": "opencode-remote-platform",
  "version": "0.1.0",
  "description": "Independent OpenCode remote install and access platform with oh-my-openagent as an optional OpenCode plugin dependency.",
  "type": "module",
  "bin": {
    "opencode-remote": "bin/opencode-remote.js",
    "opencode-remote-platform": "bin/opencode-remote.js"
  },
  "scripts": {
    "cli": "bun run src/cli-program.ts",
    "smoke": "bun run src/cli-program.ts smoke",
    "test": "bun test src/**/*.test.ts src/**/*.test.tsx",
    "typecheck": "bunx --bun tsc --noEmit",
    "build": "bun build src/cli-program.ts --outfile=dist/opencode-remote.js --target=bun",
    "build:server": "bun build src/server/management-ui-server.ts --outfile=dist/server/management-ui-server.js --target=bun",
    "dev:ui": "bunx --bun vite",
    "build:ui": "bunx --bun vite build",
    "serve:management-ui": "bun run src/server/management-ui-server.ts",
    "tauri": "bunx @tauri-apps/cli",
    "build:desktop": "bun run build:ui && bunx @tauri-apps/cli build --config '{\"build\":{\"beforeBuildCommand\":\"\"}}'",
    "lint": "bun run typecheck",
    "verify": "bun test && bun run typecheck && bun run build && bun run build:ui && bun run build:server && bun run smoke"
  },
  "keywords": [
    "opencode",
    "remote-access",
    "frp-panel",
    "cloudflare-tunnel"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bun-types": "^1.3.11",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.3"
  }
}
