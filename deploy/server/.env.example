# OpenCode Remote Platform server deployment template

OPENCODE_REMOTE_DOMAIN=example.com
OPENCODE_REMOTE_TLS_EMAIL=admin@example.com
OPENCODE_REMOTE_PUBLIC_URL=https://example.com
OPENCODE_REMOTE_INSTALL_ROOT=/opt/opencode-remote-platform
MANAGEMENT_UI_PORT=4080
MANAGEMENT_API_SESSION_TOKEN=

OPENCODE_CONFIG_DIR=/opt/opencode-remote-platform/opencode
OPENCODE_WORKSPACE_ROOT=/srv/opencode-remote/workspaces
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_SERVER_PASSWORD=change-me-long-random-password
OPENCODE_REMOTE_MANAGEMENT_UI_IMAGE=ghcr.io/jingjie1135/omo-frp/opencode-remote-management-ui:edge
OPENCODE_REMOTE_OPENCODE_IMAGE=ghcr.io/jingjie1135/omo-frp/opencode-remote-opencode:edge
OPENCODE_CONTAINER_CONTROL_ENABLED=false
OPENCODE_COMPOSE_PROJECT=opencode-remote-platform
OPENCODE_COMPOSE_SERVICE=opencode
FRP_PANEL_COMPOSE_PROJECT=opencode-remote-platform
FRP_PANEL_COMPOSE_SERVICE=frp-panel

OPENCODE_REMOTE_BASIC_AUTH_USER=opencode
# Generate this from OPENCODE_SERVER_PASSWORD and wrap the Caddy bcrypt hash in single quotes so Docker Compose does not treat `$` as interpolation.
OPENCODE_REMOTE_BASIC_AUTH_PASSWORD_HASH='replace-with-caddy-hashed-password'

FRP_PANEL_IMAGE=vaalacat/frp-panel:latest
FRP_PANEL_APP_GLOBAL_SECRET=change-me-long-random-secret
FRP_PANEL_DB_DSN=/data/data.db?_pragma=journal_mode(WAL)
FRP_PANEL_API_PORT=9000
FRP_PANEL_RPC_PORT=9001
FRP_PANEL_CLIENT_API_URL=https://frp.example.com
FRP_PANEL_CLIENT_RPC_URL=wss://frp.example.com/rpc
FRP_PANEL_INTERNAL_API_URL=http://frp-panel:9000
OPENCODE_INTERNAL_URL=http://opencode:4096
# Optional internal self-connect overrides for the frp-panel container.
FRP_PANEL_INTERNAL_CLIENT_API_URL=http://127.0.0.1:9000
FRP_PANEL_INTERNAL_CLIENT_RPC_URL=wss://127.0.0.1:9001/rpc
FRP_PANEL_CLIENT_TLS_INSECURE_SKIP_VERIFY=false
