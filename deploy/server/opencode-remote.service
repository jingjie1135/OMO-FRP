[Unit]
Description=OpenCode Remote Platform server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
EnvironmentFile=__INSTALL_ROOT__/.env
WorkingDirectory=__WORKSPACE_ROOT__
ExecStart=/usr/bin/env sh -lc 'opencode serve --hostname "$OPENCODE_HOST" --port "$OPENCODE_PORT"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__INSTALL_ROOT__ __WORKSPACE_ROOT__

[Install]
WantedBy=multi-user.target
